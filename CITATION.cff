cff-version: 1.2.0
message: "If you use this software, please cite it, and cite the poster below until the paper is published."
title: "MAREA (pyintertidal): intertidal elevation and emerged time from Sentinel-2 openEO data cubes"
type: software
authors:
  - given-names: Jorge
    family-names: "Alías Álvarez"
    email: jorge.alias.alvarez@gmail.com
