# Line endings are LF in the repository and in every checkout, so the sha256 of a text file (the replication kit's
# manifest, the notebooks, the website's data) does not depend on the machine it was checked out on.
* text=auto eol=lf
*.ipynb text eol=lf
# binary data: never converted, never diffed as text
*.npz binary
*.npy binary
*.nc binary
*.tif binary
*.tiff binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
*.pdf binary
*.pptx binary
*.pmtiles binary
*.mbtiles binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
