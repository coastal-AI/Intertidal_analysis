   "source": [
    "explain.draw_operation(\n",
    "    \"filter dates · clouds ≤ 10% over the transition zone\",\n",
    "    kind=\"filter\",\n",
    "    before={\"bands\": cube.bands, \"n_dates\": len(cube.dates), \"shape\": cube.shape},\n",
    "    after={\"bands\": cube.bands, \"n_dates\": len(usable_dates), \"shape\": cube.shape},\n",
    "    note=f\"{len(cube.dates):,} → {len(usable_dates):,} dates\",\n",
    "    params={\"cloud_threshold\": CLOUD_THRESHOLD})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1bb19947",
   "metadata": {},
   "source": [
    "## 5 · Water frequency and the intertidal zone\n",
    "\n",
    "Water frequency is the fraction of clear observations in which each pixel was\n",
    "wet. Stable water sits near 1, stable land near 0, and the intertidal zone\n",
    "spans the middle — ordered by elevation, because higher flats flood less\n",
    "often.\n",
    "\n",
    "`min_obs` guards against pixels with too little evidence: a pixel seen twice\n",
    "can report a frequency of 1.0 and mean nothing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "ff0e1029",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a pixel needs at least 15 clear observations\n",
      "water frequency computed for 837,181 px (100.0% of the grid)\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "Operation(name='water frequency', kind='reduce', params={'min_obs': 15, 'threshold': 0.0}, inputs=['305 dates'], outputs=['water frequency'], before=None, after=None, note='', seconds=0.0)"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# ── Parameters ──────────────────────────────────────────────────────────\n",
    "MIN_OBS = max(8, round(0.05 * len(usable_dates)))   # ≥8, or 5% of the archive\n",
    "print(f\"a pixel needs at least {MIN_OBS} clear observations\")\n",
    "\n",
    "# ── Water frequency (streamed over the usable dates) ────────────────────\n",
    "water_freq = pit.water_frequency(\n",
    "    cube, dates=usable_dates, threshold=NDWI_THRESHOLD, min_obs=MIN_OBS)\n",
    "\n",
    "valid = np.isfinite(water_freq)\n",
    "print(f\"water frequency computed for {valid.sum():,} px \"\n",
    "      f\"({100 * valid.mean():.1f}% of the grid)\")\n",
    "\n",
    "log.record(\"water frequency\", kind=\"reduce\",\n",
    "           params={\"min_obs\": MIN_OBS, \"threshold\": NDWI_THRESHOLD},\n",
    "           inputs=[f\"{len(usable_dates)} dates\"], outputs=[\"water frequency\"])"
   ]
  },
  {
   "cell_type": "code",
   "id": "rpt-wf",
   "metadata": {},
   "source": [
    "# The product itself: shape, grid, valid pixels and range, on the same panel\n",
    "# the cube gets. `Valid` is the number to read first — a map can look complete\n",
    "# and still be mostly NaN.\n",
    "explain.summarize(water_freq, name=\"water frequency\", transform=transform,\n",
    "                  crs=crs, long_name=\"Fraction of clear observations wet\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "id": "f1f1e766",
   "metadata": {},
   "source": [
    "The time dimension has collapsed: hundreds of dates became one map."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "54fe9c70",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
