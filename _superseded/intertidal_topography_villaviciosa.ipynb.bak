   ],
   "source": [
    "hydro = pit.hydroperiod.hydroperiod(dem.mu, series_heights)\n",
    "zones, zone_labels = pit.hydroperiod.zonation(dem.mu, series_heights)\n",
    "zone_table = pit.hydroperiod.zone_areas(zones, zone_labels, transform)\n",
    "\n",
    "print(f\"hydroperiod: {np.nanmin(hydro):.0%} – {np.nanmax(hydro):.0%} \"\n",
    "      f\"of the time submerged (median {np.nanmedian(hydro):.0%})\\n\")\n",
    "pd.DataFrame(zone_table)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fce03015",
