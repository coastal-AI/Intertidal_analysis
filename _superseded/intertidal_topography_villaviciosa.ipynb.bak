text-anchor=\"start\" font-weight=\"normal\" opacity=\"1.00\">305 × 915×915</text><line x1=\"254.0\" y1=\"91.0\" x2=\"396.0\" y2=\"91.0\" stroke=\"#333333\" stroke-width=\"1.6\" marker-end=\"url(#pit-arrow)\"/><text x=\"325.0\" y=\"81.0\" font-size=\"9.5\" font-family=\"system-ui, sans-serif\" fill=\"#333333\" text-anchor=\"middle\" font-weight=\"600\" opacity=\"1.00\">305 dates → 1 map</text><text x=\"325.0\" y=\"107.0\" font-size=\"8\" font-family=\"ui-monospace, monospace\" fill=\"#8a9199\" text-anchor=\"middle\" font-weight=\"normal\" opacity=\"1.00\">min_obs=15</text><text x=\"420.0\" y=\"62.0\" font-size=\"8\" font-family=\"ui-monospace, monospace\" fill=\"#8a9199\" text-anchor=\"end\" font-weight=\"normal\" opacity=\"1.00\">water frequency</text><rect x=\"426.0\" y=\"46.0\" width=\"26.0\" height=\"26.0\" fill=\"#2b8cbe\" opacity=\"0.75\" rx=\"0\"/><rect x=\"426.0\" y=\"46.0\" width=\"26.0\" height=\"26.0\" fill=\"none\" opacity=\"1.00\" rx=\"0\" stroke=\"#333333\" stroke-width=\"0.6\"/><text x=\"426.0\" y=\"78.0\" font-size=\"9\" font-family=\"system-ui, sans-serif\" fill=\"#333333\" text-anchor=\"start\" font-weight=\"600\" opacity=\"1.00\">after</text><text x=\"426.0\" y=\"90.0\" font-size=\"8\" font-family=\"ui-monospace, monospace\" fill=\"#8a9199\" text-anchor=\"start\" font-weight=\"normal\" opacity=\"1.00\">915×915 map</text></svg>"
