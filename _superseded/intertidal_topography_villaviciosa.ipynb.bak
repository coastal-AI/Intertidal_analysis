=\"254.9\" y2=\"232.3\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"113.6\" y1=\"80.4\" x2=\"260.2\" y2=\"80.4\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"260.2\" y1=\"80.4\" x2=\"260.2\" y2=\"227.0\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"118.9\" y1=\"75.1\" x2=\"265.5\" y2=\"75.1\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"265.5\" y1=\"75.1\" x2=\"265.5\" y2=\"221.7\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"124.2\" y1=\"69.8\" x2=\"270.8\" y2=\"69.8\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"270.8\" y1=\"69.8\" x2=\"270.8\" y2=\"216.4\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"129.5\" y1=\"64.5\" x2=\"276.1\" y2=\"64.5\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"276.1\" y1=\"64.5\" x2=\"276.1\" y2=\"211.1\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"134.8\" y1=\"59.2\" x2=\"281.4\" y2=\"59.2\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"281.4\" y1=\"59.2\" x2=\"281.4\" y2=\"205.8\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"140.1\" y1=\"53.9\" x2=\"286.7\" y2=\"53.9\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"286.7\" y1=\"53.9\" x2=\"286.7\" y2=\"200.5\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"145.4\" y1=\"48.6\" x2=\"292.0\" y2=\"48.6\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"292.0\" y1=\"48.6\" x2=\"292.0\" y2=\"195.2\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"150.7\" y1=\"43.3\" x2=\"297.3\" y2=\"43.3\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"297.3\" y1=\"43.3\" x2=\"297.3\" y2=\"189.9\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"156.0\" y1=\"38.0\" x2=\"302.6\" y2=\"38.0\" stroke=\"#000000\" stroke-width=\"0.5\"/><line x1=\"302.6\" y1=\"38.0\" x2=\"302.6\" y2=\"184.6\" stroke=\"#000000\" stroke-width=\"0.5\"/><text x=\"107.3\" y=\"321.6\" font-size=\"10\" font-family=\"ui-monospace, monospace\" fill=\"#333333\" text-anchor=\"middle\" font-weight=\"normal\" opacity=\"1.00\">915</text><text x=\"107.3\" y=\"332.6\" font-size=\"8.5\" font-family=\"system-ui, sans-serif\" fill=\"#8a9199\" text-anchor=\"middle\" font-weight=\"normal\" opacity=\"1.00\">x</text><text x=\"318.62260089118496\" y=\"107.31130044559251\" font-size=\"10\" font-family=\"ui-monospace, monospace\" fill=\"#333333\" transform=\"rotate(-90 318.62260089118496 107.31130044559251)\" text-anchor=\"middle\">915</text><text x=\"329.62260089118496\" y=\"107.31130044559251\" font-size=\"8.5\" font-family=\"system-ui, sans-serif\" fill=\"#8a9199\" transform=\"rotate(-90 329.62260089118496 107.31130044559251)\" text-anchor=\"middle\">y</text><text x=\"89.0\" y=\"91.0\" font-size=\"10\" font-family=\"ui-monospace, monospace\" fill=\"#333333\" transform=\"rotate(-45 89.0 91.0)\" text-anchor=\"middle\">1,379</text><text x=\"81.0\" y=\"82.0\" font-size=\"8.5\" font-family=\"system-ui, sans-serif\" fill=\"#8a9199\" transform=\"rotate(-45 81.0 82.0)\" text-anchor=\"middle\">t</text></svg></div><details open><summary>Coordinates <span>(4)</span></summary><table class='coords'><tr><td class='n'>band</td><td class='d'>(band) &lt;U3</td><td class='val'>'B03' 'B08' 'SCL'</td></tr><tr><td class='n'>t</td><td class='d'>(time) datetime64</td><td class='val'>2016-01-01 2016-01-11 2016-01-18 ... 2025-12-26 2025-12-28 2025-12-29</td></tr><tr><td class='n'>y</td><td class='d'>(y) float64</td><td class='val'>4,824,840 … 4,815,690</td></tr><tr><td class='n'>x</td><td class='d'>(x) float64</td><td class='val'>301,020 … 310,170</td></tr></table></details><details><summary>Attributes <span>(6)</span></summary><table class='coords'><tr><td class='n'>crs</td><td class='d'></td><td class='val'>EPSG:32630</td></tr><tr><td class='n'>resolution</td><td class='d'></td><td class='val'>10 m</td></tr><tr><td class='n'>transform</td><td class='d'></td><td class='val'>| 10.00, 0.00, 301020.00 |</td></tr><tr><td class='n'>area_of_interest</td><td class='d'></td><td class='val'>Villaviciosa — 44.4 km²</td></tr><tr><td class='n'>water_detector</td><td class='d'></td><td class='val'>ndwi</td></tr><tr><td class='n'>cache</td><td class='d'></td><td class='val'>ndwi_cube_villaviciosa_grande_10y.nc (3,093 MB on disk)</td></tr></table></details><div class='note'>The whole cube is <b>6.45 GiB</b>, far more than fits in memory. It is never loaded: every product streams it in blocks of <b>110.18 MiB</b>, which is why the length of the archive costs time rather than RAM.</div></div>"
      ],
      "text/plain": [
       "<pyintertidal summary — display it in a notebook>"
      ]
     },
     "execution_count": 6,
     "metadata": {},
