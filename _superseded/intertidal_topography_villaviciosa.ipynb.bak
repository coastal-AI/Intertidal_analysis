06.0\" width=\"26.0\" height=\"26.0\" fill=\"#9aa4ad\" opacity=\"0.75\" rx=\"0\"/><rect x=\"546.0\" y=\"106.0\" width=\"26.0\" height=\"26.0\" fill=\"none\" opacity=\"1.00\" rx=\"0\" stroke=\"#333333\" stroke-width=\"0.6\"/><rect x=\"576.0\" y=\"106.0\" width=\"26.0\" height=\"26.0\" fill=\"#9aa4ad\" opacity=\"0.75\" rx=\"0\"/><rect x=\"576.0\" y=\"106.0\" width=\"26.0\" height=\"26.0\" fill=\"none\" opacity=\"1.00\" rx=\"0\" stroke=\"#333333\" stroke-width=\"0.6\"/><text x=\"426.0\" y=\"138.0\" font-size=\"9\" font-family=\"system-ui, sans-serif\" fill=\"#333333\" text-anchor=\"start\" font-weight=\"600\" opacity=\"1.00\">after</text><text x=\"426.0\" y=\"150.0\" font-size=\"8\" font-family=\"ui-monospace, monospace\" fill=\"#8a9199\" text-anchor=\"start\" font-weight=\"normal\" opacity=\"1.00\">305 × 915×915</text></svg>"
