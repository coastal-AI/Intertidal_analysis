      "  rolling[k] = np.nanmedian(nd[sel], axis=0)\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[step · 2023-2025] 17,165 px\n",
      "  elevation [-2.13, 1.13] m\n",
      "  sub-pixel relief σ: median nan cm | saturated 0%\n",
      "  uncertainty: median nan cm\n",
      "\n",
      "coverage: HSR 17,209 px vs step 17,165 px\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
