       "<div class='pit-repr'><div class='hdr'><b>pyintertidal.SentinelCube</b> <span class='dims'>'Villaviciosa' (<i>band:</i> 3, <i>time:</i> 1,379, <i>y:</i> 915, <i>x:</i> 915)</span></div><div class='body'><svg width='17' height='17' viewBox='0 0 24 24' fill='none' stroke='#39424b' stroke-width='1.7'><ellipse cx='12' cy='5' rx='8' ry='3'/><path d='M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5'/><path d='M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'/></svg><table class='sizes'><tr><th></th><th>Array</th><th>Chunk</th></tr><tr><td class='k'>Bytes</td><td class='v'>6.45 GiB</td><td class='v'>128.00 KiB</td></tr><tr><td class='k'>Shape</td><td class='v'>(3, 1,379, 915, 915)</td><td class='v'>(3, 1, 256, 256)</td></tr><tr><td class='k'>Chunks</td><td class='v'>66,192 on disk</td><td class='v'>1×256×256</td></tr><tr><td class='k'>Streaming</td><td class='v'>110.18 MiB in RAM</td><td class='v'>23 dates/pass</td></tr><tr><td class='k'>Data type</td><td class='v'>int16 numpy.ndarray</td><td class='v'></td></tr></table><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"365\" height=\"353\" viewBox=\"0 0 365 353\"><defs><marker id=\"pit-arrow\" markerWidth=\"9\" markerHeight=\"7\" refX=\"8\" refY=\"3.5\" orient=\"auto\"><polygon points=\"0 0, 9 3.5, 0 7\" fill=\"#333333\"/></marker></defs><rect x=\"0.0\" y=\"0.0\" width=\"364.6\" height=\"352.6\" fill=\"#ffffff\" opacity=\"1.00\" rx=\"6\"/><polygon points=\"34,160.0 160.0,34.000000000000014 306.622600891185,34.000000000000014 180.622600891185,160.0\" fill=\"#ECB172\" opacity=\"0.75\" stroke=\"#000000\" stroke-width=\"1\"/><polygon points=\"180.622600891185,160.0 306.62260089118496,34.000000000000014 306.62260089118496,180.62260089118502 180.622600891185,306.622600891185\" fill=\"#ECB172\" opacity=\"0.62\" stroke=\"#000000\" stroke-width=\"1\"/><rect x=\"34.0\" y=\"160.0\" width=\"146.6\" height=\"146.6\" fill=\"#ECB172\" opacity=\"0.95\" rx=\"0\" stroke=\"#000000\" stroke-width=\"1\"/><line x1=\"75.0\" y1=\"160.0\" x2=\"75.0\" y2=\"306.6\" strok